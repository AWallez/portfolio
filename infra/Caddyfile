# Reverse proxy public + HTTPS automatique (Let's Encrypt).
# Caddy obtient et renouvelle le certificat tout seul, redirige 80→443,
# et proxy vers le conteneur `web` (Nginx) via le réseau Docker interne.
{
	# e-mail ACME : reçoit les avis d'expiration de certificat
	email wallezalexis@gmail.com
}

# www → domaine principal (canonique)
www.alexiswallez.fr {
	redir https://alexiswallez.fr{uri} permanent
}

alexiswallez.fr {
	# TOUS les en-têtes de sécurité sont posés ici, à l'edge — un seul endroit,
	# appliqués uniformément à chaque réponse. (Avant, X-Frame/X-Content-Type/
	# Referrer venaient de Nginx, mais un add_header dans un location — cache
	# des assets, no-store d'index.html — ANNULE ceux hérités du bloc server :
	# certaines réponses partaient sans en-têtes.) CSP volontairement omise
	# (script anti-flash inline dans le <head>).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# Nginx (web) compresse déjà en gzip. On fait simplement TRAVERSER sa réponse :
	# `compression off` désactive la décompression automatique du transport Go de
	# Caddy, et on demande explicitement du gzip à l'upstream. Le navigateur reçoit
	# donc bien du gzip (le `encode` de Caddy, lui, ne re-compressait pas la sortie
	# du reverse_proxy dans cette version).
	reverse_proxy web:80 {
		header_up Accept-Encoding gzip
		transport http {
			compression off
		}
	}
}

# ntfy (notifications push : formulaire de contact + alertes monitoring),
# exposé en HTTPS pour que le téléphone s'abonne hors LAN. Auth deny-all
# côté ntfy : seuls les comptes autorisés lisent/publient.
ntfy.alexiswallez.fr {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy ntfy:80
}

# Back-office (CRM, conteneur `admin`) : réseau local et VPN seulement.
# En HTTPS et sur son propre nom : le mot de passe et le cookie de session ne
# passent plus en clair sur le Wi-Fi, et ce cookie (`__Host-`, lié à ce seul
# nom) ne part plus vers les autres services du NAS, comme il le faisait quand
# l'admin était servi en HTTP sur un simple port.
crm.alexiswallez.fr {
	@public not remote_ip 192.168.1.0/24 10.8.0.0/24
	respond @public "403 — Accès réservé au LAN/VPN." 403
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy admin:3002
}

# Blocs locaux à la machine de déploiement (services personnels hors
# portfolio) : fichiers *.caddy dans conf.d/, non versionnés (gitignorés)
# → ils survivent aux `git reset --hard` des déploiements.
import conf.d/*.caddy
