# Reverse proxy public + HTTPS automatique (Let's Encrypt).
# Caddy obtient et renouvelle le certificat tout seul, redirige 80→443,
# et proxy vers le conteneur `web` (Nginx) via le réseau Docker interne.
{
	# e-mail ACME : reçoit les avis d'expiration de certificat
	email wallezalexis@gmail.com
}

# www → domaine principal (canonique)
www.alexiswallez.fr {
	redir https://alexiswallez.fr{uri} permanent
}

alexiswallez.fr {
	# TOUS les en-têtes de sécurité sont posés ici, à l'edge — un seul endroit,
	# appliqués uniformément à chaque réponse. (Avant, X-Frame/X-Content-Type/
	# Referrer venaient de Nginx, mais un add_header dans un location — cache
	# des assets, no-store d'index.html — ANNULE ceux hérités du bloc server :
	# certaines réponses partaient sans en-têtes.)
	#
	# CSP APPLIQUÉE depuis le 16/10/2026, après quatre jours en rapport seul sans
	# une seule violation réelle. Le navigateur bloque tout le reste et le
	# signale toujours à /api/csp-report (journal de l'API, « violation CSP ») :
	# une violation y veut dire qu'une partie du site ne marche plus. Ce qu'elle
	# autorise, et pourquoi :
	#  - script : le site, le script anti-flash d'index.html PAR SON EMPREINTE
	#    (à recalculer s'il change : frontend/src/test/csp.test.ts le vérifie),
	#    Umami (stats.) et Turnstile (challenges.cloudflare.com) ;
	#  - style : le site, plus l'attribut style du bloc <noscript> (empreinte,
	#    'unsafe-hashes' ne vaut que pour elle) ;
	#  - police en data: (une police de JetBrains Mono intégrée au CSS par Vite) ;
	#  - connexions vers stats. (mesure d'audience), cadre de Turnstile.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# fenêtre isolée des pages qu'elle ouvre ou qui l'ouvrent (Spectre, tabnabbing)
		Cross-Origin-Opener-Policy "same-origin"
		Reporting-Endpoints `csp="https://alexiswallez.fr/api/csp-report"`
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-ZjJeofEk2aSF6ybCcPTDYqHiomk43BUW+JdweNrN2r4=' https://stats.alexiswallez.fr https://challenges.cloudflare.com; style-src 'self' 'unsafe-hashes' 'sha256-S5B3VjwJFSnwO0iI5kac+oM0TYaZedw8L5z41rXCm2Y='; img-src 'self'; font-src 'self' data:; connect-src 'self' https://stats.alexiswallez.fr; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; report-uri /api/csp-report; report-to csp"
		-Server
	}
	# Nginx (web) compresse déjà en gzip. On fait simplement TRAVERSER sa réponse :
	# `compression off` empêche le transport Go de Caddy de demander du gzip de
	# lui-même puis de le décompresser. L'en-tête Accept-Encoding du visiteur
	# passe tel quel : Nginx ne compresse que pour qui l'accepte. (Il était
	# forcé à gzip, et un client qui refusait la compression la recevait quand
	# même. Le `encode` de Caddy, lui, ne re-compressait pas la sortie du
	# reverse_proxy dans cette version.)
	reverse_proxy web:80 {
		transport http {
			compression off
		}
	}
}

# ntfy (notifications push : formulaire de contact + alertes monitoring),
# exposé en HTTPS pour que le téléphone s'abonne hors LAN. Auth deny-all
# côté ntfy : seuls les comptes autorisés lisent/publient.
ntfy.alexiswallez.fr {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy ntfy:80
}

# Back-office (CRM, conteneur `admin`) : réseau local et VPN seulement.
# En HTTPS et sur son propre nom : le mot de passe et le cookie de session ne
# passent plus en clair sur le Wi-Fi, et ce cookie (`__Host-`, lié à ce seul
# nom) ne part plus vers les autres services du NAS, comme il le faisait quand
# l'admin était servi en HTTP sur un simple port.
crm.alexiswallez.fr {
	@public not remote_ip 192.168.1.0/24 10.8.0.0/24
	respond @public "403 — Accès réservé au LAN/VPN." 403
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy admin:3002
}

# Blocs locaux à la machine de déploiement (services personnels hors
# portfolio) : fichiers *.caddy dans conf.d/, non versionnés (gitignorés)
# → ils survivent aux `git reset --hard` des déploiements.
import conf.d/*.caddy
